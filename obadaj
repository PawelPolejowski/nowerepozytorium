function moje_pakiety_config() {
    return array(
        array(
            'pakiet_id' => 21409,                  // ID pakietu A2 Bundle
            'skladniki' => array( 21198, 20146 ),
        ),
        array(
            'pakiet_id' => 20706,                  // ID pakietu B1 & B2 Speaking Booster 
            'skladniki' => array( 20702, 20698 ),
        ),
        // kolejny pakiet: skopiuj blok array( ... ), i zmień ID
    );
