// =====================================================================
// 5. Komunikaty pakietów jako popup
// =====================================================================
function popup_wyciagnij_komunikaty() {
    if ( ! function_exists( 'WC' ) || ! WC()->session ) {
        return array();
    }

    $wszystkie = wc_get_notices();
    $wynik     = array();

    foreach ( $wszystkie as $typ => $lista ) {
        foreach ( $lista as $i => $n ) {
            if ( is_array( $n ) && ! empty( $n['data']['popup'] ) ) {
                $wynik[] = array( 'typ' => $typ, 'tekst' => $n['notice'] );
                unset( $wszystkie[ $typ ][ $i ] );
            }
        }
    }

    if ( $wynik ) {
        wc_set_notices( $wszystkie );
    }

    return $wynik;
}

function popup_dane_html( $komunikaty ) {
    $html = '<div class="pakiet-popup-dane" hidden>';
    foreach ( $komunikaty as $k ) {
        $html .= '<p class="pakiet-popup-' . esc_attr( $k['typ'] ) . '">' . wp_kses_post( $k['tekst'] ) . '</p>';
    }
    return $html . '</div>';
}

add_action( 'template_redirect', 'popup_pobierz_komunikaty', 20 );

function popup_pobierz_komunikaty() {
    global $popup_komunikaty;
    $popup_komunikaty = popup_wyciagnij_komunikaty();
}

add_filter( 'woocommerce_add_to_cart_fragments', 'popup_fragment' );

function popup_fragment( $fragments ) {
    $fragments['div.pakiet-popup-dane'] = popup_dane_html( popup_wyciagnij_komunikaty() );
    return $fragments;
}

add_action( 'wp_footer', 'popup_wyswietl', 5 );

function popup_wyswietl() {
    global $popup_komunikaty;
    $dane = ! empty( $popup_komunikaty ) ? $popup_komunikaty : array();

    echo popup_dane_html( $dane );
    ?>
    <div class="pakiet-popup" hidden>
        <div class="pakiet-popup-okno" role="dialog" aria-modal="true">
            <div class="pakiet-popup-tresc"></div>
            <div class="pakiet-popup-przyciski">
                <a href="<?php echo esc_url( wc_get_cart_url() ); ?>" class="pakiet-popup-koszyk">Przejdź do koszyka</a>
                <button type="button" class="pakiet-popup-zamknij">OK</button>
            </div>
        </div>
    </div>
    <script>
    (function () {
        var okno = document.querySelector('.pakiet-popup');
        if (!okno) { return; }
        var tresc = okno.querySelector('.pakiet-popup-tresc');

        function pokaz() {
            var dane = document.querySelector('.pakiet-popup-dane');
            if (!dane || !dane.children.length) { return; }
            tresc.innerHTML = dane.innerHTML;
            dane.innerHTML = '';
            okno.hidden = false;
            okno.querySelector('.pakiet-popup-zamknij').focus();
        }

        function zamknij() { okno.hidden = true; }

        okno.addEventListener('click', function (e) {
            if (e.target === okno || e.target.closest('.pakiet-popup-zamknij')) { zamknij(); }
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') { zamknij(); }
        });

        pokaz();

        if (window.jQuery) {
            jQuery(document.body).on('added_to_cart', function () {
                setTimeout(pokaz, 100);
            });
        }
    })();
    </script>
    <?php
}

// 6. W koszyku: informacja, że produkt jest częścią zestawu + przycisk dodania zestawu
add_filter( 'woocommerce_cart_item_name', 'pokaz_info_o_zestawie_w_koszyku', 20, 3 );

function pokaz_info_o_zestawie_w_koszyku( $nazwa, $cart_item, $cart_item_key ) {

    if ( ! is_cart() || ! WC()->cart ) {
        return $nazwa;
    }

    // ID produktów, które są teraz w koszyku
    $w_koszyku = array();
    foreach ( WC()->cart->get_cart() as $item ) {
        $w_koszyku[] = $item['product_id'];
    }

    $html = '';

    foreach ( moje_pakiety_config() as $cfg ) {

        // produkt nie należy do tego zestawu albo zestaw jest już w koszyku
        if ( ! in_array( $cart_item['product_id'], $cfg['skladniki'] ) || in_array( $cfg['pakiet_id'], $w_koszyku ) ) {
            continue;
        }

        $pakiet = wc_get_product( $cfg['pakiet_id'] );
        if ( ! $pakiet || ! $pakiet->is_purchasable() || ! $pakiet->is_in_stock() ) {
            continue;
        }

        // oszczędność: suma cen wszystkich składników minus cena zestawu
        $suma = 0;
        foreach ( $cfg['skladniki'] as $sk_id ) {
            $sk = wc_get_product( $sk_id );
            if ( $sk ) {
                $suma += (float) wc_get_price_to_display( $sk );
            }
        }
        $oszczednosc = $suma - (float) wc_get_price_to_display( $pakiet );

        if ( $oszczednosc <= 0 ) {
            continue;
        }

        $url = add_query_arg( 'add-to-cart', $cfg['pakiet_id'], wc_get_cart_url() );

        $html .= '<div class="info-zestaw">';
        $html .= '<div class="info-zestaw-tekst">';
        $html .= 'Ten produkt jest częścią zestawu <strong>' . esc_html( $pakiet->get_name() ) . '</strong>, ';
        $html .= 'dzięki któremu możesz zaoszczędzić <strong>' . wc_price( $oszczednosc ) . '</strong>.';
        $html .= '</div>';
        $html .= '<a href="' . esc_url( $url ) . '" class="button info-zestaw-przycisk">Dodaj cały zestaw</a>';
        $html .= '</div>';
    }

    return $nazwa . $html;
}

// 7. Po dodaniu zestawu usuń z koszyka jego pojedyncze składniki
add_action( 'woocommerce_add_to_cart', 'usun_skladniki_po_dodaniu_zestawu', 20, 2 );

function usun_skladniki_po_dodaniu_zestawu( $cart_item_key, $product_id ) {

    foreach ( moje_pakiety_config() as $cfg ) {

        if ( $product_id != $cfg['pakiet_id'] ) {
            continue;
        }

        foreach ( WC()->cart->get_cart() as $key => $item ) {
            if ( in_array( $item['product_id'], $cfg['skladniki'] ) ) {
                WC()->cart->remove_cart_item( $key );
            }
        }
        break;
    }
}

