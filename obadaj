// =====================================================================
// 1. Blokuj dodanie pojedynczego składnika, gdy jego pakiet jest w koszyku
// =====================================================================
add_filter( 'woocommerce_add_to_cart_validation', 'blokuj_skladniki_gdy_jest_pakiet', 10, 2 );

function blokuj_skladniki_gdy_jest_pakiet( $passed, $product_id ) {
    if ( ! WC()->cart ) {
        return $passed;
    }

    $w_koszyku = array();
    foreach ( WC()->cart->get_cart() as $item ) {
        $w_koszyku[] = $item['product_id'];
    }

    foreach ( moje_pakiety_config() as $cfg ) {
        if ( in_array( $product_id, $cfg['skladniki'] ) && in_array( $cfg['pakiet_id'], $w_koszyku ) ) {
            wc_add_notice( 'Ten produkt jest już częścią pakietu, który masz w koszyku.', 'error', array( 'popup' => true ) );
            return false;
        }
    }

    return $passed;
}

// =====================================================================
// 2. Komplet składników w koszyku => zamień na pakiet
// =====================================================================
add_action( 'woocommerce_add_to_cart', 'zamien_skladniki_na_pakiet', 20, 2 );

function zamien_skladniki_na_pakiet( $cart_item_key, $product_id ) {
    static $w_trakcie = false;
    if ( $w_trakcie ) {
        return;
    }

    $cart = WC()->cart;

    // mapa: ID produktu => klucze pozycji w koszyku
    $w_koszyku = array();
    foreach ( $cart->get_cart() as $key => $item ) {
        $w_koszyku[ $item['product_id'] ][] = $key;
    }

    foreach ( moje_pakiety_config() as $cfg ) {

        if ( ! in_array( $product_id, $cfg['skladniki'] ) ) {
            continue;
        }

        if ( isset( $w_koszyku[ $cfg['pakiet_id'] ] ) ) {
            continue;
        }

        $komplet = true;
        foreach ( $cfg['skladniki'] as $sk ) {
            if ( ! isset( $w_koszyku[ $sk ] ) ) {
                $komplet = false;
                break;
            }
        }
        if ( ! $komplet ) {
            continue;
        }

        $w_trakcie = true;

        // najpierw dodaj pakiet, dopiero potem usuń składniki
        $dodano = $cart->add_to_cart( $cfg['pakiet_id'], 1 );

        if ( $dodano ) {
            foreach ( $cfg['skladniki'] as $sk ) {
                foreach ( $w_koszyku[ $sk ] as $key ) {
                    $cart->remove_cart_item( $key );
                }
            }
            wc_add_notice( 'Dodałeś wszystkie produkty z pakietu, więc zastąpiliśmy je jednym pakietem.', 'success', array( 'popup' => true ) );
        }

        $w_trakcie = false;
        break;
    }
}

// =====================================================================
// 3. Pod nazwą pakietu w koszyku: skład, ceny i oszczędność
// =====================================================================
add_filter( 'woocommerce_cart_item_name', 'pokaz_sklad_pakietu_w_koszyku', 10, 3 );

function pokaz_sklad_pakietu_w_koszyku( $nazwa, $cart_item, $cart_item_key ) {

    foreach ( moje_pakiety_config() as $cfg ) {

        if ( $cart_item['product_id'] != $cfg['pakiet_id'] ) {
            continue;
        }

        $suma  = 0;
        $linie = '';

        foreach ( $cfg['skladniki'] as $sk_id ) {
            $sk = wc_get_product( $sk_id );
            if ( ! $sk ) {
                continue;
            }
            $cena  = (float) wc_get_price_to_display( $sk );
            $suma += $cena;

            $linie .= '<li>' . esc_html( $sk->get_name() ) . ' &ndash; ' . wc_price( $cena ) . '</li>';
        }

        if ( $linie === '' ) {
            return $nazwa;
        }

        $cena_pakietu = (float) wc_get_price_to_display( $cart_item['data'] );
        $oszczednosc  = $suma - $cena_pakietu;

        $html  = '<div class="sklad-pakietu">';
        $html .= '<small>Zawiera:</small>';
        $html .= '<ul class="sklad-pakietu-lista">' . $linie . '</ul>';

        if ( $oszczednosc > 0 ) {
            $html .= '<strong class="sklad-pakietu-oszczednosc">Kupując zestaw oszczędzasz ' . wc_price( $oszczednosc ) . '</strong>';
        }

        $html .= '</div>';

        return $nazwa . $html;
    }

    return $nazwa;
}

